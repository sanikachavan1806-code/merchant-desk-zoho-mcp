# demo: fixtures, no Zoho account required
# live: calls Zoho Inventory
ZOHO_MODE=demo

# Eight Zoho datacenters: us, eu, in, au, jp, ca, sa, cn
# Indian merchants are on `in`.
ZOHO_DC=in
ZOHO_ORGANIZATION_ID=

# OAuth server-based client. Requested scopes are read-only.
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REDIRECT_URI=http://127.0.0.1:8765/callback

# Self-client / pre-generated token mode. Reviewers can skip the browser.
ZOHO_ACCESS_TOKEN=
ZOHO_REFRESH_TOKEN=

# Fernet key. Required before refresh tokens are written to disk.
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=
TOKEN_STORE_PATH=.tokens/zoho.json

# Plan ceiling used by get_api_budget. Override if Zoho has raised this org.
# Introduction defaults: free 1000, standard 2000, professional 5000,
# premium 10000, enterprise 10000.
ZOHO_PLAN=free
# ZOHO_DAILY_LIMIT=

# This connector refuses to start if READ_ONLY is false.
READ_ONLY=true

# The model cannot unmask phone/email unless this is also true.
ZOHO_REVEAL_PII=false

AUDIT_LOG_PATH=logs/audit.jsonl

# Optional Razorpay payments export (JSON). Empty uses the built-in fixture in demo mode,
# and leaves payment ids unverified in live mode. Amounts are rupees unless amount_unit is paise.
RAZORPAY_EXPORT_PATH=
MERCHANTOPS_HOST=127.0.0.1
MERCHANTOPS_PORT=8000
